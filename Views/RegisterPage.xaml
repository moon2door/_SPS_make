<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_SPS.Views.RegisterPage"
             xmlns:viewmodels="clr-namespace:_SPS.ViewModels"
             Title="Sign Up">

    <ContentPage.BindingContext>
        <viewmodels:RegisterViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

            <Label 
                Text="Create a new account"
                FontSize="24"
                HorizontalOptions="Center"
                FontAttributes="Bold"
                Margin="0,0,0,10"/>

            <Entry
                Placeholder="Email (Required)"
                Text="{Binding Email}"
                Keyboard="Email" />

            <Entry
                Placeholder="Password (Required, min 6 chars)"
                Text="{Binding Password}"
                IsPassword="True" />

            <Entry
                Placeholder="Nickname (ID)"
                Text="{Binding Nickname}" />

            <Label Text="Select Account Type:" FontSize="14" TextColor="Gray"/>
            <Picker Title="Select User Type"
                    ItemsSource="{Binding UserTypes}"
                    SelectedItem="{Binding SelectedUserTypeName}" />

            <Entry
                Placeholder="Organization Name (If applicable)"
                Text="{Binding OrganizationName}" />

            <Entry
                Placeholder="Address (Required for Org/Shelter)"
                Text="{Binding Address}" />

            <Entry
                Placeholder="Phone Number"
                Text="{Binding PhoneNumber}"
                Keyboard="Telephone" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="Blue" />

            <Button
                Text="Sign up"
                Command="{Binding RegisterCommand}"
                IsEnabled="{Binding CanExecute}"
                Margin="0,20,0,0"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>