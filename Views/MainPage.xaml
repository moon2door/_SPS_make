<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:_SPS.ViewModels"
             xmlns:models="clr-namespace:_SPS.Models"
             x:Class="_SPS.Views.MainPage"
             Title="SPS Home">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *" RowSpacing="0" BackgroundColor="#F5F5F5">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Padding="20" BackgroundColor="White">
            <Label Text="{Binding WelcomeMessage}" 
                   FontSize="20" FontAttributes="Bold" TextColor="#333"/>

            <Button Text="+ Register New Animal" 
                    Command="{Binding GoToAddPetCommand}" 
                    IsVisible="{Binding IsShelterMode}"
                    BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>

            <Button Text="📢 Report Lost Pet" 
                    IsVisible="{Binding IsSeekerMode}"
                    BackgroundColor="#FF9800" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>

            <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsAdopterMode}">
                <Entry Placeholder="Search species (e.g. Dog)" Text="{Binding SearchSpecies}" />
                <Button Grid.Column="1" Text="Search" Command="{Binding SearchPetsCommand}" Margin="10,0,0,0"/>
            </Grid>

            <Button Text="Logout" Command="{Binding LogoutCommand}" 
                    BackgroundColor="Transparent" TextColor="Gray" FontSize="12" 
                    HorizontalOptions="End" HeightRequest="30"/>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadPetsCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Pets}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PetModel">
                        <Frame Margin="10,5" Padding="0" CornerRadius="10" HasShadow="True" BorderColor="Transparent">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=GoToDetailCommand}" 
                              CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="120, *" HeightRequest="120">
                                <Image Grid.Column="0" Source="{Binding ImageUrl1}" Aspect="AspectFill" BackgroundColor="LightGray"/>

                                <StackLayout Grid.Column="1" Padding="10" Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                    <Label Text="{Binding Species}" FontSize="14" TextColor="Gray"/>
                                    <Label Text="{Binding Location}" FontSize="12" TextColor="#666"/>
                                    <Label Text="{Binding Status}" FontSize="12" TextColor="OrangeRed" FontAttributes="Bold"/>
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>