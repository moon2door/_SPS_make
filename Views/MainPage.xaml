<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:_SPS.ViewModels"
             xmlns:models="clr-namespace:_SPS.Models"
             x:Class="_SPS.Views.MainPage"
             Title="SPS Home">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *" RowSpacing="0" BackgroundColor="#F5F5F5">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Padding="20" BackgroundColor="White">

            <Label Text="{Binding WelcomeMessage}" 
                   FontSize="20" FontAttributes="Bold" TextColor="#333"/>

            <Button Text="+ Register New Animal" 
                    Command="{Binding GoToAddPetCommand}" 
                    IsVisible="{Binding IsShelterMode}"
                    BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>

            <Button Text="📢 Report Lost Pet" 
                    Command="{Binding GoToAddPetCommand}"
                    IsVisible="{Binding IsSeekerMode}"
                    BackgroundColor="#FF9800" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>

            <Frame IsVisible="{Binding IsSearchVisible}" BackgroundColor="#F0F8FF" Padding="15" CornerRadius="10" BorderColor="#B3E5FC" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Find Your Perfect Companion" FontSize="14" FontAttributes="Bold" TextColor="#0277BD"/>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                        <Entry Grid.Column="0" Placeholder="Location (City/District)" Text="{Binding SearchLocation}" BackgroundColor="White" FontSize="13"/>
                        <Button Grid.Column="1" Text="🌍" Command="{Binding GetCurrentLocationCommand}" WidthRequest="45" BackgroundColor="#29B6F6" TextColor="White"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Entry Grid.Column="0" Placeholder="Breed (e.g. Poodle)" Text="{Binding SearchSpecies}" BackgroundColor="White" FontSize="13"/>
                        <Entry Grid.Column="1" Placeholder="Age (e.g. 2)" Text="{Binding SearchAge}" Keyboard="Numeric" BackgroundColor="White" FontSize="13"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Frame Grid.Column="0" Padding="0" BackgroundColor="White" BorderColor="LightGray" HasShadow="False" HeightRequest="40">
                            <Picker SelectedItem="{Binding SearchGender}" Title="Gender" TextColor="Black" FontSize="13" VerticalTextAlignment="Center">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>All</x:String>
                                        <x:String>Male</x:String>
                                        <x:String>Female</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                        <Button Grid.Column="1" Text="Search" Command="{Binding SearchPetsCommand}" BackgroundColor="#0288D1" FontAttributes="Bold" HeightRequest="40"/>
                    </Grid>

                    <Button Text="Reset Filter" Command="{Binding ResetFilterCommand}" BackgroundColor="Transparent" TextColor="Gray" FontSize="11" HorizontalOptions="Center" HeightRequest="30" Margin="0,-5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Logout" Command="{Binding LogoutCommand}" 
                    BackgroundColor="Transparent" TextColor="Gray" FontSize="12" 
                    HorizontalOptions="End" HeightRequest="30"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Pets}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PetModel">
                    <Frame Margin="10,5" Padding="0" CornerRadius="10" HasShadow="True" BorderColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=GoToDetailCommand}" 
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="120, *" HeightRequest="120">
                            <Image Grid.Column="0" Source="{Binding ImageUrl1}" Aspect="AspectFill" BackgroundColor="LightGray"/>
                            <StackLayout Grid.Column="1" Padding="10" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{Binding Species}" FontSize="14" TextColor="Gray"/>
                                <Label Text="{Binding Location}" FontSize="12" TextColor="#666"/>
                                <Label Text="{Binding Status}" FontSize="12" TextColor="OrangeRed" FontAttributes="Bold"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>